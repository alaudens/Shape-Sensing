function result = linspaceVectors(v1, v2, n)
    % Generates n evenly spaced vectors between v1 and v2
    % v1, v2 - Input vectors (same size)
    % n - Number of points

    steps = linspace(0, 1, n); % Create interpolation factors
    result = v1 + steps .* (v2 - v1); % Element-wise interpolation
end

% function that determines length of center line between IMUs assuming the straight distance between IMUs is 4" 
function s_new = lengthAdjustment(s, theta)
    theta = rad2deg(theta);
    s_new = 0.000192*theta^2 - 0.0322*theta + s + 0.5;
end
